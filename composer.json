{
  "name": "loggasynk/connect-api",
  "description": "Conector PHP 8.4+ simples e reutilizavel para a API LoggaSynk.",
  "version": "0.1.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "LoggaSynk\\ConnectApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LoggaSynk\\ConnectApi\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "test": "phpunit",
    "auth:test": "php examples/authenticate.php",
    "api:smoke": "php examples/smoke.php",
    "example:instance": "php examples/instance-read.php",
    "example:create-instance": "php examples/create-instance.php",
    "example:profile": "php examples/profile-settings.php",
    "example:webhook": "php examples/webhook.php",
    "example:messages": "php examples/send-messages.php",
    "lint": "find src tests examples -name '*.php' -print0 | xargs -0 -n1 php -l",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
